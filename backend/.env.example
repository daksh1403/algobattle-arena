# --- App ---
APP_NAME=algobattle
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Comma-separated allowed CORS origins. Use "*" for development only.
ALLOWED_ORIGINS=*

# --- Admin ---
# Admin key for web_arena.py. MUST be set in production.
ADMIN_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://algobattle:algobattle@localhost:5432/algobattle
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
SYNC_DATABASE_URL=postgresql+psycopg2://algobattle:algobattle@localhost:5432/algobattle

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# --- JWT ---
JWT_SECRET=change-me-in-production-please-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# --- Judge0 ---
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_POLL_INTERVAL_SECONDS=1.0
JUDGE0_TIMEOUT_SECONDS=15

# --- RQ ---
RQ_QUEUE_NAME=algobattle-judge
RQ_WORKER_COUNT=2
