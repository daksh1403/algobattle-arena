# ============================================================================
# Algobattle — Environment Variables
# ----------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env file.
# ============================================================================

# ----------------------------------------------------------------------------
# Core platform
# ----------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=info                    # debug | info | warning | error
DOMAIN=localhost                  # Public hostname (e.g. algobattle.example.com)
ACME_EMAIL=admin@example.com      # Let's Encrypt registration email

# ----------------------------------------------------------------------------
# Postgres
# ----------------------------------------------------------------------------
POSTGRES_USER=algobattle
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=algobattle
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Connection string the API uses:
DATABASE_URL=postgresql+asyncpg://algobattle:change_me_postgres_password@postgres:5432/algobattle
# For Alembic migrations (sync driver):
DATABASE_URL_SYNC=postgresql://algobattle:change_me_postgres_password@postgres:5432/algobattle

# ----------------------------------------------------------------------------
# Redis (queue + cache)
# ----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
RQ_QUEUE_NAME=submissions

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------
API_PORT=8000
API_WORKERS=2                      # gunicorn workers; small-scale = 2, larger = cpu/2
SECRET_KEY=change_me_jwt_secret_at_least_32_chars_long
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
CORS_ORIGINS=http://localhost,http://localhost:3000
API_METRICS_ENABLED=true

# ----------------------------------------------------------------------------
# Judge worker
# ----------------------------------------------------------------------------
JUDGE_WORKER_CONCURRENCY=4
JUDGE_POLL_INTERVAL=1.0
JUDGE_HTTP_TIMEOUT=30
JUDGE_CALLBACK_URL=http://api:8000/internal/submissions/callback

# ----------------------------------------------------------------------------
# Judge0
# ----------------------------------------------------------------------------
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=change_me_judge0_internal_token
JUDGE0_CALLBACK_URL=http://api:8000/internal/submissions/judge0-callback
JUDGE0_ENABLE_NETWORK=false
JUDGE0_MAX_CPU_TIME=5
JUDGE0_MAX_WALL_TIME=10
JUDGE0_MAX_MEMORY=256000
JUDGE0_MAX_STACK=128000

# Judge0 internal DB + Redis (separate from our own)
JUDGE0_POSTGRES_PASSWORD=change_me_judge0_postgres_password
JUDGE0_REDIS_PASSWORD=change_me_judge0_redis_password

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost/api

# ----------------------------------------------------------------------------
# Traefik
# ----------------------------------------------------------------------------
TRAEFIK_DASHBOARD=true
TRAEFIK_API_DASHBOARD_AUTH=admin:$$apr1$$abc$$def      # htpasswd format
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_ENTRYPOINTS_HTTP=:80
TRAEFIK_ENTRYPOINTS_HTTPS=:443

# ----------------------------------------------------------------------------
# Prometheus / Grafana / Loki
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=168h               # 7 days
ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME/CHANGE

# ----------------------------------------------------------------------------
# AWS / Terraform only (read by .github/workflows/cd.yml)
# ----------------------------------------------------------------------------
AWS_REGION=us-east-1
EC2_SSH_KEY_NAME=algobattle-prod
EC2_SSH_PRIVATE_KEY=               # paste contents or use secret manager
EC2_USER=ubuntu
DEPLOY_HOST=                       # public DNS of API EC2
DEPLOY_REGISTRY=ghcr.io
DEPLOY_OWNER=your-org
DEPLOY_IMAGE_API=ghcr.io/your-org/algobattle-api
DEPLOY_IMAGE_JUDGE=ghcr.io/your-org/algobattle-judge
DEPLOY_IMAGE_FRONTEND=ghcr.io/your-org/algobattle-frontend
GHCR_TOKEN=                        # provided by workflow

# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
FEATURE_REGISTRATION_OPEN=true
FEATURE_LEADERBOARD_PUBLIC=true
FEATURE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@algobattle.example.com