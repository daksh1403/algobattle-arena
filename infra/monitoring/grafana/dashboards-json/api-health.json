{
  "annotations": {"list": []},
  "description": "Algobattle API health: RPS, latencies, error rates, status codes.",
  "editable": true,
  "uid": "algobattle-api",
  "title": "Algobattle — API Health",
  "tags": ["algobattle", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "RPS",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum(rate(http_requests_total{job=\"algobattle-api\"}[5m]))", "refId": "A", "legendFormat": "rps"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p99 latency",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "api:latency_p99:5m", "refId": "A", "legendFormat": "p99"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 2}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum(rate(http_requests_total{job=\"algobattle-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"algobattle-api\"}[5m]))", "refId": "A", "legendFormat": "errors"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active connections",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum(traefik_entrypoint_open_connections)", "refId": "A", "legendFormat": "open"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      },
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum(rate(http_requests_total{job=\"algobattle-api\"}[5m])) by (status)", "refId": "A", "legendFormat": "{{status}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "api:latency_p50:5m", "refId": "A", "legendFormat": "p50"},
        {"expr": "api:latency_p95:5m", "refId": "B", "legendFormat": "p95"},
        {"expr": "api:latency_p99:5m", "refId": "C", "legendFormat": "p99"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth"}
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Top slow routes",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"algobattle-api\"}[5m])) by (le, route)))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "line"}}
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_requests_total{job=\"algobattle-api\"}[5m])) by (route))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 10}}
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "API logs (Loki)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "datasource": {"type": "loki", "uid": "Loki"},
      "targets": [
        {
          "expr": "{service=\"algobattle-api\"} |~ \"(?i)(error|exception|traceback)\"",
          "refId": "A"
        }
      ],
      "options": {"showTime": true, "showLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true}
    }
  ]
}